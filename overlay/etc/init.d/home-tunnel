#!/bin/sh /etc/rc.common
START=18
STOP=10
USE_PROCD=1
start_service() {
    [ -f /data/home-tunnel/enabled ] || return 0
    procd_open_instance
    procd_set_param command /usr/libexec/home-tunnel-run
    procd_set_param respawn 3600 3 0
    procd_set_param file /data/home-tunnel/config.json
    procd_close_instance
}
stop_service() {
    if [ -f /data/home-tunnel/enabled ]; then
        /usr/libexec/home-tunnel-control guard
    fi
}
